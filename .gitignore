node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Ergebnisse der Vektorisierer-Tests (nur zum Draufschauen, jederzeit
# neu erzeugbar via: npx tsx scripts/test-vektor.ts).
.vektor-test/

# Freeze-Artefakte des Import-Endlevels (I1): gefrorene End-HTML + Protokoll,
# jederzeit neu erzeugbar via: node scripts/freeze-seite.mjs.
scripts/.freeze-out/

# Freeze-Materialisierung der E4-Route (I6): hochgereichte Ordner-Inhalte des
# UI-Imports werden hier temporaer materialisiert, damit die serverseitige
# Freeze-Kernlogik sie rendern kann. Wird nach jedem Lauf aufgeraeumt.
scripts/.freeze-tmp/

# Zugangsdaten (Canva client_secret o.ä.) — duerfen NIE ins Repo.
# .env.local.example bleibt bewusst getrackt: nur Variablennamen, keine Werte.
.env
.env.*
!.env.*.example

# Build-Ordner der isolierten Builds (NEXT_DIST_DIR).
.next-build/

# Standalone Embed-Bundle (Phase 2) — generiertes Artefakt aus
# components/embed/, nicht committen. Wird von `npm run build` (s.
# package.json: laeuft vor `next build`) und manuell via
# `npm run build:embed` neu erzeugt.
public/wee-embed.js
public/wee-embed.css

# Dev-Server-Logs (Durchlaufposten, nie committen)
.next-dev-*.log
test-sites/

# Seiten-Papierkorb (U7/N2): geloeschte Seiten wandern reversibel hierher.
# seiten/ selbst ist getrackt (wee-website-v3.json), der Papierkorb NICHT —
# das sind fluechtige Loesch-/Undo-Reste, kein Quellstand.
seiten/.papierkorb/

# Asset-Papierkorb des Re-Imports (I6, /api/import/asset aktion="leeren"):
# vor einem Re-Import geleerte public/import/<slug>/-Ordner wandern reversibel
# hierher — fluechtige Undo-Reste, kein Quellstand.
public/import/.papierkorb/

# Ordner-Struktur-Export (Station 4 / S2, POST /api/export/ordner): deploybarer
# Rohbau je Website unter export/<slug>/ — reines Build-Output, jederzeit neu
# erzeugbar, nie committen. Fuehrender Slash: NUR die Wurzel export/, nicht der
# Quellcode-Ordner app/api/export/.
/export/

# Statischer Vorschau-Spiegel des Ordner-Exports (Station 4 / X4, spiegel:true):
# public/export/<slug>/ wird nur fuer die iframe-Vorschau geschrieben (Next
# liefert es statisch aus). Reines Dev-Artefakt, jederzeit neu erzeugbar.
/public/export/

# Instatic-Klon (Sichtung/Referenz, eigenes Upstream-Repo — nicht mitversionieren)
/instatic/

# Spike-Build-Artefakt
spike-plugin.zip
